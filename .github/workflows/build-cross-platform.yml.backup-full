name: Build Cross-Platform

on:
  push:
    branches:
      - codex/graph-server-32ch
      - main
      - master
      - develop
    tags:
      - "v*"
  pull_request:
    branches:
      - codex/graph-server-32ch
      - main
      - master
      - develop
  workflow_dispatch:

permissions:
  contents: write

jobs:
  checks:
    name: Checks
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libwebkit2gtk-4.1-dev \
            libgtk-3-dev \
            libayatana-appindicator3-dev \
            librsvg2-dev \
            libusb-1.0-0-dev \
            libssl-dev \
            libsoup-3.0-dev \
            libjavascriptcoregtk-4.1-dev \
            libglib2.0-dev \
            libgdk-pixbuf-2.0-dev \
            libcairo2-dev \
            libpango1.0-dev \
            libatk1.0-dev

      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.7.0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      - name: Setup Rust cache
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: ".->target"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run Rust tests
        run: cargo test --workspace --lib --bins

      - name: Build frontend
        run: pnpm build

  build-macos:
    needs: checks
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: arm64
            target: aarch64-apple-darwin
            runner: macos-14
          - arch: x64
            target: x86_64-apple-darwin
            runner: macos-13

    runs-on: ${{ matrix.runner }}

    name: Build macOS (${{ matrix.arch }})

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.7.0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      - name: Setup Rust cache
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: ".->target"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build Tauri app
        run: pnpm tauri build --target ${{ matrix.target }} --bundles app,dmg

      - name: Prepare macOS artifacts
        shell: bash
        run: |
          set -euo pipefail

          bundle_root="target/${{ matrix.target }}/release/bundle"
          app_dir="$bundle_root/macos"
          dmg_dir="$bundle_root/dmg"

          if [[ ! -d "$app_dir" ]]; then
            echo "Missing macOS app bundle directory: $app_dir" >&2
            exit 1
          fi

          app_path="$(find "$app_dir" -maxdepth 1 -name "*.app" -print -quit)"

          if [[ -z "$app_path" ]]; then
            echo "No .app bundle found in $app_dir" >&2
            exit 1
          fi

          # Create .app.zip
          ditto -c -k --sequesterRsrc --keepParent \
            "$app_path" \
            "$bundle_root/pxlogic-studio-macos-${{ matrix.arch }}.app.zip"

          # Find and rename DMG if exists
          if [[ -d "$dmg_dir" ]]; then
            dmg_path="$(find "$dmg_dir" -maxdepth 1 -name "*.dmg" -print -quit)"
            if [[ -n "$dmg_path" ]]; then
              cp "$dmg_path" "$bundle_root/pxlogic-studio-macos-${{ matrix.arch }}.dmg"
            fi
          fi

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: pxlogic-macos-${{ matrix.arch }}
          path: |
            target/${{ matrix.target }}/release/bundle/pxlogic-studio-macos-${{ matrix.arch }}.app.zip
            target/${{ matrix.target }}/release/bundle/pxlogic-studio-macos-${{ matrix.arch }}.dmg
          if-no-files-found: error
          retention-days: 30

  build-windows:
    needs: checks
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x64
            target: x86_64-pc-windows-msvc
            runner: windows-latest

    runs-on: ${{ matrix.runner }}

    name: Build Windows (${{ matrix.arch }})

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.7.0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      - name: Setup Rust cache
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: ".->target"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build Tauri app
        env:
          TAURI_SKIP_DEVTOOLS_CHECK: true
        run: |
          # Skip native resource preparation on Windows
          node -e "const fs=require('fs');const conf=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8'));conf.build.beforeBuildCommand='pnpm build';fs.writeFileSync('src-tauri/tauri.conf.json',JSON.stringify(conf,null,2));"
          pnpm tauri build --target ${{ matrix.target }} --bundles nsis,msi

      - name: Prepare Windows artifacts
        shell: pwsh
        run: |
          $bundleRoot = "target/${{ matrix.target }}/release/bundle"
          $nsisDir = "$bundleRoot/nsis"
          $msiDir = "$bundleRoot/msi"

          # Find and rename NSIS installer
          if (Test-Path $nsisDir) {
            $nsisInstaller = Get-ChildItem -Path $nsisDir -Filter "*.exe" | Select-Object -First 1
            if ($nsisInstaller) {
              Copy-Item $nsisInstaller.FullName "$bundleRoot/pxlogic-studio-windows-${{ matrix.arch }}.exe"
            }
          }

          # Find and rename MSI installer
          if (Test-Path $msiDir) {
            $msiInstaller = Get-ChildItem -Path $msiDir -Filter "*.msi" | Select-Object -First 1
            if ($msiInstaller) {
              Copy-Item $msiInstaller.FullName "$bundleRoot/pxlogic-studio-windows-${{ matrix.arch }}.msi"
            }
          }

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: pxlogic-windows-${{ matrix.arch }}
          path: |
            target/${{ matrix.target }}/release/bundle/pxlogic-studio-windows-${{ matrix.arch }}.exe
            target/${{ matrix.target }}/release/bundle/pxlogic-studio-windows-${{ matrix.arch }}.msi
          if-no-files-found: error
          retention-days: 30

  build-linux:
    needs: checks
    strategy:
      fail-fast: false
      matrix:
        include:
          - arch: x64
            target: x86_64-unknown-linux-gnu
            runner: ubuntu-22.04

    runs-on: ${{ matrix.runner }}

    name: Build Linux (${{ matrix.arch }})

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libwebkit2gtk-4.1-dev \
            libgtk-3-dev \
            libayatana-appindicator3-dev \
            librsvg2-dev \
            patchelf \
            libusb-1.0-0-dev \
            libssl-dev \
            libsoup-3.0-dev \
            libjavascriptcoregtk-4.1-dev \
            libglib2.0-dev \
            libgdk-pixbuf-2.0-dev \
            libcairo2-dev \
            libpango1.0-dev \
            libatk1.0-dev

      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.7.0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      - name: Setup Rust cache
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: ".->target"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build Tauri app
        run: |
          # Skip native resource preparation on Linux
          node -e "const fs=require('fs');const conf=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8'));conf.build.beforeBuildCommand='pnpm build';fs.writeFileSync('src-tauri/tauri.conf.json',JSON.stringify(conf,null,2));"
          pnpm tauri build --target ${{ matrix.target }} --bundles appimage,deb

      - name: Prepare Linux artifacts
        shell: bash
        run: |
          set -euo pipefail

          bundle_root="target/${{ matrix.target }}/release/bundle"
          appimage_dir="$bundle_root/appimage"
          deb_dir="$bundle_root/deb"

          # Find and rename AppImage
          if [[ -d "$appimage_dir" ]]; then
            appimage_path="$(find "$appimage_dir" -maxdepth 1 -name "*.AppImage" -print -quit)"
            if [[ -n "$appimage_path" ]]; then
              cp "$appimage_path" "$bundle_root/pxlogic-studio-linux-${{ matrix.arch }}.AppImage"
              chmod +x "$bundle_root/pxlogic-studio-linux-${{ matrix.arch }}.AppImage"
            fi
          fi

          # Find and rename DEB
          if [[ -d "$deb_dir" ]]; then
            deb_path="$(find "$deb_dir" -maxdepth 1 -name "*.deb" -print -quit)"
            if [[ -n "$deb_path" ]]; then
              cp "$deb_path" "$bundle_root/pxlogic-studio-linux-${{ matrix.arch }}.deb"
            fi
          fi

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: pxlogic-linux-${{ matrix.arch }}
          path: |
            target/${{ matrix.target }}/release/bundle/pxlogic-studio-linux-${{ matrix.arch }}.AppImage
            target/${{ matrix.target }}/release/bundle/pxlogic-studio-linux-${{ matrix.arch }}.deb
          if-no-files-found: error
          retention-days: 30

  release:
    needs: [build-macos, build-windows, build-linux]
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest

    steps:
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: release-artifacts
          merge-multiple: true

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          files: release-artifacts/**/*
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
