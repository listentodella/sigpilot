# Build outputs and dependency caches
/target/
/src-tauri/target/
/node_modules/
/dist/

# Local reference checkouts / extracted application data.
# Keep these on disk for porting, but do not mix them into this repo's history.
/.app-data/
/pxview-fork/

# Local captures are useful while debugging, but should be promoted to a
# deliberate test fixture before they enter version control.
/debug-captures/
/assets/*.pxl

# Generated bundle helper resources. Keep the directory in git, but rebuild
# native helper binaries during packaging.
/resources/native/*
!/resources/native/.gitkeep

# Local machine files
/.DS_Store
# Unanchored form so Finder's droppings are ignored at every level, not just
# the repository root (tools/.DS_Store was slipping through).
.DS_Store
/.env.local
/.env.*.local
*.log

# Vite writes these timestamped config snapshots next to the real config while
# it reloads; they are temporary and machine-specific.
vite.config.ts.timestamp-*.mjs
