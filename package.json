{
  "name": "sigpilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "demo:markers": "vite --config tools/analyzer-markers-demo/vite.config.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "perf:self-test": "cargo run --release -p sigpilot-graph --bin sigpilot-perf-self-test --",
    "i18n:extract": "i18next-cli extract",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "dev:webusb": "vite --mode webusb",
    "build:webusb": "tsc && vite build --mode webusb",
    "verify:webusb-shared": "node tools/webusb-verify/shared-workbench.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "decimal.js": "^10.6.0",
    "fflate": "0.8.2",
    "html2canvas": "1.4.1",
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "13.1.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-beautiful-dnd": "13.1.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "i18next-cli": "^1.75.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  },
  "packageManager": "pnpm@11.7.0"
}
