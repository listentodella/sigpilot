{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "PXLogic Studio",
  "version": "0.1.0",
  "identifier": "dev.pxlogic.studio",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri-resources.mjs && pnpm dev",
    "beforeBuildCommand": "pnpm build && node scripts/prepare-tauri-resources.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PXLogic Studio",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../resources/bitstreams": "resources/bitstreams",
      "../resources/firmware": "resources/firmware",
      "../resources/native": "resources/native"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libusb-1.0-0"]
      }
    }
  }
}
